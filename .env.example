# Copy to `.env` (repo root or server/) and fill in your own values.

# Port for the Express + Socket.io server
PORT=4000

# API key required by POST /api/analyze (sent as the `x-api-key` header).
# The same value is forwarded to the pluggable prediction service in
# server/src/services/predictor.js when you wire in an external API.
API_KEY=replace-me-with-a-long-random-string
